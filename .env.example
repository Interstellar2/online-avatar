# 阿里云百炼 API Key（https://bailian.console.aliyun.com/）
DASHSCOPE_API_KEY=

# ASR：百炼实时语音识别（服务端 VAD 自动判停）
ASR_MODEL=qwen3-asr-flash-realtime
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 服务端 VAD 参数
ASR_VAD_THRESHOLD=0.2
ASR_VAD_SILENCE_MS=400

# LLM：百炼 OpenAI 兼容接口
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_SYSTEM_PROMPT=你是一个友好的数字人助手，回答请简洁口语化，适合语音播报。

# TTS：百炼 CosyVoice 实时合成（输出 PCM16 单声道）
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# cosyvoice PCM 输出采样率，须与所选模型/格式一致（22050 或 24000）
TTS_SAMPLE_RATE=22050
TTS_VOLUME=50
TTS_RATE=1.0
TTS_PITCH=1.0

# 上游 WS 保活间隔（秒），对 ASR/TTS 一致
UPSTREAM_PING_INTERVAL=20

# 前端上行音频采样率（麦克风 PCM16 单声道）
INPUT_AUDIO_SAMPLE_RATE=16000

# 服务
HOST=0.0.0.0
PORT=8000
# 服务
HOST=0.0.0.0
PORT=8000
# 默认方案：cascade（真实级联）/ echo（mock，无需密钥）
DEFAULT_SOLUTION=cascade
